Prefix(:=<http://example.org/simple-ontology#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<http://example.org/simple-ontology>
  Declaration(Class(:Animal))
  Declaration(Class(:Mammal))
  Declaration(Class(:Human))
  Declaration(ObjectProperty(:hasParent))
  
  SubClassOf(:Mammal :Animal)
  SubClassOf(:Human :Mammal)
  
  ClassAssertion(:Human :John)
  ClassAssertion(:Human :Jane)
  
  ObjectPropertyAssertion(:hasParent :John :Jane)
)
